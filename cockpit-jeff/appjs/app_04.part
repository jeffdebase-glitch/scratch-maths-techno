async function browserDriveList(token){const q=`'${state.settings.driveFolderId}' in parents and trashed=false and mimeType='application/pdf'`;const u=new URL('https://www.googleapis.com/drive/v3/files');u.searchParams.set('q',q);u.searchParams.set('fields','files(id,name,modifiedTime,size,mimeType)');u.searchParams.set('orderBy','modifiedTime desc');u.searchParams.set('pageSize','100');const r=await fetch(u,{headers:{Authorization:`Bearer ${token}`}});if(!r.ok)throw new Error('Drive API '+r.status);return (await r.json()).files||[]}
async function browserDriveFile(token,id){const r=await fetch(`https://www.googleapis.com/drive/v3/files/${encodeURIComponent(id)}?alt=media`,{headers:{Authorization:`Bearer ${token}`}});if(!r.ok)throw new Error('Téléchargement Drive impossible');return r.blob()}
async function syncDrive({silent=false}={}){saveSettingsFromDriveFields();let files,fetcher,mode='server';try{files=await backendDriveList();fetcher=id=>backendDriveFile(id)}catch(e){mode='browser';if(silent){$('#driveStatus').textContent='● Sync serveur à configurer';return}const token=await browserToken();files=await browserDriveList(token);fetcher=id=>browserDriveFile(token,id)}const fresh=files.filter(f=>!state.driveSeen.includes(f.id)).sort((a,b)=>new Date(a.modifiedTime)-new Date(b.modifiedTime));if(!fresh.length){$('#driveStatus').textContent='● À jour';toast('Google Drive est à jour');return}$('#driveStatus').textContent=`● ${fresh.length} nouveau(x) PDF`;for(const f of fresh){toast(`Analyse ${f.name}…`);try{const blob=await fetcher(f.id),p=await parseFitProfilePdf(blob,f.name);if(Number.isFinite(p.weight)){addMeasurement(p,f.id)}else{manualConfirm(p,f.name,f.id);break}}catch(e){console.error(e);toast('Erreur sur '+f.name)}}state.lastDriveSync=new Date().toISOString();saveState();renderAll();$('#driveStatus').textContent=`● Sync ${mode==='server'?'automatique':'Google'} terminée`;toast('Synchronisation terminée')}
function saveSettingsFromDriveFields(){state.settings.driveFolderId=$('#driveFolderId')?.value.trim()||state.settings.driveFolderId;state.settings.googleClientId=$('#googleClientId')?.value.trim()||'';state.settings.autoSync=!!$('#autoSync')?.checked;saveState()}

async function syncLinkedData({silent=false}={}){try{const r=await fetch('/.netlify/functions/linked-data',{cache:'no-store'});if(!r.ok)throw new Error('linked backend unavailable');const data=await r.json(),days=data.days||{};state.connected={...state.connected,...days};saveState();renderAll();if(!silent)toast('Données liées synchronisées')}catch(e){if(!silent)toast('Données liées non configurées')}}

function parseCSV(text){const lines=text.split(/\r?\n/).filter(l=>l.trim()&&!l.trim().startsWith('#'));if(lines.length<2)return [];const parseLine=line=>{const out=[];let cur='',q=false;for(let i=0;i<line.length;i++){const ch=line[i];if(ch==='"'){if(q&&line[i+1]==='"'){cur+='"';i++}else q=!q}else if((ch===','||ch===';')&&!q){out.push(cur.trim());cur=''}else cur+=ch}out.push(cur.trim());return out};const heads=parseLine(lines[0]);return lines.slice(1).filter(Boolean).map(line=>{const vals=parseLine(line),o={};heads.forEach((h,i)=>o[h]=vals[i]??'');return o})}
function healthLensRange(text){const m=text.match(/^# Date Range:\s*(.+?)\s+to\s+(.+)$/m);return m?{start:m[1].trim(),end:m[2].trim()}:null}
function isMidnightIso(x){return /T00:00:00(?:\.000)?[+-]/.test(x||'')}
async function importConnected(file){let rows,text='';if(file.name.toLowerCase().endsWith('.json'))rows=JSON.parse(await file.text());else{text=await file.text();rows=parseCSV(text)}const isHealthLens=/^# HealthLens Export/m.test(text)||rows.some(r=>r.type&&r.date&&r.value);if(isHealthLens){const gran=(text.match(/^# Granularity:\s*(.+)$/m)||[])[1]?.trim().toLowerCase();if(gran&&gran!=='daily totals')return toast('HealthLens : choisissez « daily totals »');const range=healthLensRange(text),days={};for(const r of rows){const date=(r.date||'').slice(0,10),v=num(r.value);if(!date||!Number.isFinite(v))continue;days[date]||={source:'HealthLens',granularity:'daily totals',partial:false};if(r.type==='Steps')days[date].steps=v;else if(r.type==='Active Energy')days[date].activeEnergyKcal=v;else if(r.type==='Heart Rate')days[date].heartRateAvg=v;else if(r.type==='Sleep Analysis')days[date].sleepHours=v}if(range){const sd=range.start.slice(0,10),ed=range.end.slice(0,10);if(days[sd]&&!isMidnightIso(range.start))days[sd].partial=true;if(days[ed])days[ed].partial=true}Object.entries(days).forEach(([date,d])=>{state.connected[date]={...(state.connected[date]||{}),...d}});saveState();renderAll();const complete=Object.values(days).filter(d=>d.partial!==true).length;toast(`${complete} jours HealthLens complets importés`);return}let n=0;rows.forEach(r=>{const date=(r.date||r.Date||'').slice(0,10);if(!date)return;state.connected[date]={steps:num(r.steps),calories:num(r.calories),activeEnergyKcal:num(r.activeEnergyKcal),heartRateAvg:num(r.heartRateAvg||r.heartRate),activityMinutes:num(r.activityMinutes||r.activity),sleepHours:num(r.sleepHours||r.sleep),trainingMinutes:num(r.trainingMinutes||r.training),partial:false};n++});saveState();renderAll();toast(`${n} jours importés`)}
function downloadCSVTemplate(){const s='date,steps,activeEnergyKcal,heartRateAvg,sleepHours,activityMinutes,trainingMinutes\n2026-09-19,10000,1500,72,7.5,75,45\n';downloadBlob(new Blob([s],{type:'text/csv'}),'cockpit-jeff-donnees-liees-modele.csv')}

function saveGoal(){const lo=num($('#targetLow').value),hi=num($('#targetHigh').value),single=num($('#targetSingle').value);if(!(lo<hi))return toast('La borne basse doit être inférieure à la borne haute');state.settings.targetLow=lo;state.settings.targetHigh=hi;state.settings.targetSingle=single;saveState();renderAll();toast('Objectif enregistré')}
function installPWA(){if(deferredPrompt){deferredPrompt.prompt();deferredPrompt.userChoice.finally(()=>deferredPrompt=null);return}const ios=/iphone|ipad|ipod/i.test(navigator.userAgent);openModal(`<h2>Installer Cockpit Jeff</h2><p>${ios?'Sur iPhone : ouvrez cette page dans Safari, touchez le bouton Partager, puis « Sur l’écran d’accueil ». L’app s’ouvrira ensuite en plein écran.':'Utilisez le menu de votre navigateur puis « Installer l’application » ou « Ajouter à l’écran d’accueil ».'}</p><button class="primary full" data-action="close-modal">Compris</button>`);$('#modalContent [data-action="close-modal"]').onclick=closeModal}
function stabilityInfo(){openModal(`<h2>Score de stabilité</h2><p>Le score utilise uniquement la dispersion des poids des 90 derniers jours. Formule : <b>100 × (1 − écart-type / largeur de la zone cible)</b>, bornée entre 0 et 100.</p><p>Il ne mesure ni la santé ni la qualité de la composition corporelle. Le pourcentage de mesures réellement dans la zone est affiché séparément dans le rapport hebdomadaire.</p><button class="primary full" data-action="close-modal">Fermer</button>`);$('#modalContent [data-action="close-modal"]').onclick=closeModal}

function renderAll(){measurements=mergeMeasurements();renderHome();renderTrends();renderData();renderSettings()}

function bind(){$$('.nav-btn').forEach(b=>b.addEventListener('click',()=>switchView(b.dataset.nav)));document.body.addEventListener('click',e=>{const a=e.target.closest('[data-action]');if(!a)return;const x=a.dataset.action;if(x==='go-data')switchView('data');if(x==='go-trends')switchView('trends');if(x==='go-settings')switchView('settings');if(x==='go-data-variation'){journalFilter='variation';switchView('data');renderJournal()}if(x==='close-modal')closeModal();if(x==='open-weekly')openWeekly();if(x==='stability-info')stabilityInfo();if(x==='save-goal')saveGoal();if(x==='install-pwa')installPWA();if(x==='import-pdf')$('#pdfInput').click();if(x==='sync-drive')syncDrive().catch(err=>{console.error(err);toast(err.message)});if(x==='download-csv')downloadCSVTemplate();if(x==='import-connected')$('#connectedInput').click();if(x==='export-image')exportWeeklyPNG();if(x==='export-pdf')exportWeeklyPDF();if(x==='export-month-image')exportMonthlyPNG();if(x==='export-month-pdf')exportMonthlyPDF()});$('#homePeriod').addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;currentHomeDays=+b.dataset.days;$$('#homePeriod button').forEach(x=>x.classList.toggle('active',x===b));renderHome()});$('#homeMetric').addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;currentHomeMetric=b.dataset.metric;$$('#homeMetric button').forEach(x=>x.classList.toggle('active',x===b));renderHome()});$('#journalFilter').addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;journalFilter=b.dataset.filter;$$('#journalFilter button').forEach(x=>x.classList.toggle('active',x===b));renderJournal()});$('#periodA').addEventListener('change',renderCompare);$('#periodB').addEventListener('change',renderCompare);$('#modeSelect').addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;state.settings.mode=b.dataset.mode;saveState();renderSettings();renderHome()});$('#driveFolderId').addEventListener('change',saveSettingsFromDriveFields);$('#googleClientId').addEventListener('change',saveSettingsFromDriveFields);$('#autoSync').addEventListener('change',saveSettingsFromDriveFields);$('#pdfInput').addEventListener('change',e=>importPDFs([...e.target.files]));$('#connectedInput').addEventListener('change',e=>{if(e.target.files[0])importConnected(e.target.files[0])});window.addEventListener('beforeinstallprompt',e=>{e.preventDefault();deferredPrompt=e});}

if('serviceWorker' in navigator&&location.protocol.startsWith('http'))navigator.serviceWorker.register('sw.js').catch(console.warn);
bind();renderAll();
if(location.protocol.startsWith('http')){
  setTimeout(()=>syncLinkedData({silent:true}),700);
}
if(state.settings.autoSync&&location.protocol.startsWith('http')){
  setTimeout(()=>syncDrive({silent:true}).catch(()=>{}),1200);
  setInterval(()=>{if(document.visibilityState==='visible'){syncDrive({silent:true}).catch(()=>{});syncLinkedData({silent:true})}},5*60*1000);
  document.addEventListener('visibilitychange',()=>{if(document.visibilityState==='visible'){syncDrive({silent:true}).catch(()=>{});syncLinkedData({silent:true})}});
}
})();
