e,b.date)))} jours</span>`;const zs=$('#zoneStatus');zs.textContent=inZone(a.weight)?'● Dans la zone':'● Hors zone';zs.className='status-pill '+(inZone(a.weight)?'green':'orange');$('#targetLabel').textContent=t.label;$('#rangeMidLabel').textContent=state.settings.mode==='single'?'Cible':'Objectif';const visualLow=t.low-3,visualHigh=t.high+4;$('#rangeMinLabel').textContent=fmt(visualLow,0);$('#rangeMaxLabel').textContent=fmt(visualHigh,0);$('#rangeZone').style.left=(100*(t.low-visualLow)/(visualHigh-visualLow))+'%';$('#rangeZone').style.width=(100*(t.high-t.low)/(visualHigh-visualLow))+'%';$('#rangeDot').style.left=(100*clamp((a.weight-visualLow)/(visualHigh-visualLow),0,1))+'%';$('#movingAvg').textContent=fmt(ma)+' kg';$('#trendGap').textContent=(gap>=0?'+':'')+fmt(gap)+' kg';$('#trendGap').style.color=gap>0.5?'var(--orange)':'var(--green)';$('#pbfValue').textContent=fmt(a.pbf,1)+' %';$('#muscleValue').textContent=fmt(a.muscle,1)+' kg';const pbf30=metricChangeDays('pbf',30),mus30=metricChangeDays('muscle',30);$('#pbfChange').textContent=pbf30==null?'—':`${pbf30<=0?'↓':'↑'} ${fmt(Math.abs(pbf30),1)} % sur ~30 jours`;$('#muscleChange').textContent=mus30==null?'—':`${mus30>=0?'↑':'↓'} ${fmt(Math.abs(mus30),1)} kg sur ~30 jours`;$('#fatSpark').innerHTML=sparkSVG(measurements.slice(-7).map(x=>x.pbf),'#8055f6');$('#muscleSpark').innerHTML=sparkSVG(measurements.slice(-7).map(x=>x.muscle),'#397bff');const cutoff=+new Date(a.date)-currentHomeDays*DAY,arr=measurements.filter(x=>+new Date(x.date)>=cutoff);$('#homeChart').innerHTML=lineSVG(arr,currentHomeMetric,{tags:true});const sig=currentSignal();$('#signalTitle').textContent=sig.title;$('#signalText').textContent=sig.text;renderLinkedMini();}
function renderLinkedMini(){const d=state.connected[isoDay(latest().date)]||{},tog=state.settings.connectedToggles;const items=[['steps','Pas',d.steps!=null?Math.round(d.steps).toLocaleString('fr-FR'):'À connecter'],['sleep','Sommeil',d.sleepHours!=null?fmt(d.sleepHours,1)+' h':'À connecter'],['training','Entraînement',d.trainingMinutes!=null?Math.round(d.trainingMinutes)+' min':'À connecter']].filter(x=>tog[x[0]]!==false);$('#linkedMini').innerHTML=items.map(x=>`<div class="linked-mini"><small>${x[1]}</small><strong>${x[2]}</strong></div>`).join('');const pairs=matchedConnected();$('#correlationNote').textContent=pairs.length>=5?'Associations statistiques calculées dans l’onglet Données — sans interprétation causale.':'Ajoutez au moins 5 journées de données liées pour calculer des associations.'}

function periodData(code){const end=+new Date(latest().date),ld=new Date(latest().date),year=ld.getFullYear(),month=ld.getMonth();if(code==='last90')return measurements.filter(m=>+new Date(m.date)>=end-90*DAY);if(code==='prev90')return measurements.filter(m=>{const x=+new Date(m.date);return x>=end-180*DAY&&x<end-90*DAY});if(code==='last30')return measurements.filter(m=>+new Date(m.date)>=end-30*DAY);if(code==='prev30')return measurements.filter(m=>{const x=+new Date(m.date);return x>=end-60*DAY&&x<end-30*DAY});if(code==='monthCurrent')return measurements.filter(m=>{const d=new Date(m.date);return d.getFullYear()===year&&d.getMonth()===month});if(code==='monthPrev'){const p=new Date(year,month-1,1);return measurements.filter(m=>{const d=new Date(m.date);return d.getFullYear()===p.getFullYear()&&d.getMonth()===p.getMonth()})}return []}
function renderCompare(){const A=periodData($('#periodA').value),B=periodData($('#periodB').value);const specs=[['weight','Poids moyen','kg',2],['pbf','Graisse moyenne','%',1],['muscle','Muscle moyen','kg',1]];$('#compareStats').innerHTML=specs.map(([k,l,u,d])=>{const av=avg(A.map(x=>x[k]).filter(Number.isFinite)),bv=avg(B.map(x=>x[k]).filter(Number.isFinite)),delta=av!=null&&bv!=null?av-bv:null,pct=delta!=null&&bv?100*delta/bv:null;return `<div class="compare-stat"><small>${l}</small><strong>${delta==null?'—':(delta>=0?'+':'')+fmt(delta,d)+' '+u}</strong><em>${pct==null?'Données insuffisantes':(pct>=0?'↑ ':'↓ ')+fmt(Math.abs(pct),1)+' %'}</em></div>`}).join('')}
function monthlyPhases(){const map=new Map();measurements.forEach(m=>{const d=new Date(m.date),k=`${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}`;if(!map.has(k))map.set(k,[]);map.get(k).push(m.weight)});const mons=[...map.entries()].map(([k,v])=>({k,avg:avg(v)}));const phases=[];for(let i=0;i<mons.length;i++){let type='stable';if(i){const d=mons[i].avg-mons[i-1].avg;if(d<-.4)type='down';else if(d>.4)type='up'}if(phases.length&&phases.at(-1).type===type)phases.at(-1).count++;else phases.push({type,count:1})}return {mons,phases}}
function renderTrends(){renderCompare();$('#yearChart').innerHTML=lineSVG(measurements,'weight',{height:250});const {phases}=monthlyPhases(),total=phases.reduce((s,p)=>s+p.count,0);$('#phaseBar').innerHTML=phases.map(p=>`<span class="phase ${p.type}" style="flex:${p.count}"></span>`).join('')+`<div class="phase-legend" style="width:100%"><span>Vert : baisse</span><span>Violet : stable</span><span>Orange : hausse</span></div>`;const a=latest(),cutoff=+new Date(a.date)-90*DAY,vals=measurements.filter(m=>+new Date(m.date)>=cutoff).map(m=>m.weight),width=Math.max(.1,target().high-target().low),score=Math.round(100*(1-clamp(sd(vals)/width,0,1)));$('#stabilityScore').innerHTML=`${score}<small style="font-size:28px;color:#69799a"> / 100</small>`;$('#stabilityLabel').textContent=score>=80?'Bonne stabilité':score>=60?'Stabilité moyenne':'Dispersion élevée';$('#scoreFill').style.width=score+'%';const ev=variationEvents();$('#variationSummary').innerHTML=ev.length?ev.slice(0,3).map(v=>`<div class="variation-item"><div><div class="variation-value">${v.delta>0?'+':''}${fmt(v.delta,2)} kg / ~7 jours</div><div class="variation-note">${frDate(v.p.date,{day:'2-digit',month:'short'})} → ${frDate(v.m.date,{day:'2-digit',month:'short'})}</div></div><div class="variation-note">À surveiller, sans conclure à une variation de graisse.</div></div>`).join(''):'<div class="micro-note">Aucune variation ≥ 1 kg sur une fenêtre proche de 7 jours.</div>'}

function renderData(){const a=latest();$('#latestSummary').innerHTML=`<div class="summary-main"><small>Dernière pesée · ${frDate(a.date,{day:'2-digit',month:'short'})}</small><strong>${fmt(a.weight)} <span style="font-size:18px">kg</span></strong><small>${inZone(a.weight)?'Dans la zone cible':'Hors zone cible'}</small></div><div class="summary-box"><small>Graisse</small><strong>${fmt(a.pbf,1)} %</strong></div><div class="summary-box"><small>Muscle</small><strong>${fmt(a.muscle,1)} kg</strong></div>`;const latestVar=variationEvents()[0];$('#variationBanner').innerHTML=latestVar&&latestVar.m.date===a.date?`<h3>⚠ Variation à surveiller</h3><p>Le poids a varié de <b>${latestVar.delta>0?'+':''}${fmt(latestVar.delta,2)} kg</b> par rapport à une mesure proche de 7 jours. Cela peut refléter eau, glycogène, sodium, contenu digestif ou d’autres facteurs ; ce signal n’est pas interprété comme une prise de graisse.</p>`:`<h3>✓ Pas de variation brusque récente</h3><p>Aucun écart d’au moins 1 kg n’est détecté sur la comparaison disponible proche de 7 jours.</p>`;renderJournal();renderCorrelations();}
function isVariationMeasurement(m){return variationEvents().some(v=>v.m.date===m.date)}
function renderJournal(){const end=+new Date(latest().date),weekStart=end-7*DAY;let arr=[...measurements].reverse();if(journalFilter==='tagged')arr=arr.filter(m=>contextFor(m).tags?.length);if(journalFilter==='variation')arr=arr.filter(isVariationMeasurement);if(journalFilter==='week')arr=arr.filter(m=>+new Date(m.date)>=weekStart);$('#journalList').innerHTML=arr.map(m=>{const c=contextFor(m),tags=(c.tags||[]).map(t=>`<span class="tag ${slug(t)}">${t}</span>`).join('');return `<div class="journal-row" data-date="${m.date}"><div class="journal-date"><strong>${frDate(m.date,{day:'2-digit',month:'short',year:'numeric'})}</strong><small>${frDate(m.date,{weekday:'long'})}</small></div><div class="journal-weight">${fmt(m.weight)} kg</div><div class="tag-wrap">${tags||'<span class="micro-note">Ajouter du contexte</span>'}</div><span class="chev">›</span></div>`}).join('');$$('.journal-row').forEach(r=>r.addEventListener('click',()=>openContext(r.dataset.date)))}
function slug(s){return s.normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^a-zA-Z0-9]+/g,'-').toLowerCase()}
function renderCorrelations(){const tagStats=TAGS.map(tag=>{const withTag=measurements.filter(m=>(contextFor(m).tags||[]).includes(tag));let rises=0,n=0;withTag.forEach(m=>{const idx=measurements.findIndex(x=>x.date===m.date);if(idx>0){n++;if(m.weight-measurements[idx-1].weight>.2)rises++}});return {tag,n,pct:n?100*rises/n:null}}).filter(x=>x.n>=2).sort((a,b)=>b.n-a.n);const linked=linkedCorrelations();let html='';if(tagStats.length)html+=tagStats.slice(0,4).map(x=>`<div class="corr-row"><div><strong>${x.tag}</strong><small>${x.n} mesures contextualisées — association descriptive</small></div><div class="corr-value ${x.pct>=50?'pos':'neg'}">${fmt(x.pct,0)} % avec hausse