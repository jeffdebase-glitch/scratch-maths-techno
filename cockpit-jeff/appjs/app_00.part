(() => {
'use strict';
const DAY=86400000;
const STORE='cockpitJeffStateV4';
const DEFAULT_SETTINGS={targetLow:68,targetHigh:71,targetSingle:70,mode:'maintain',driveFolderId:'1BAs1jR4W7IgtyudZ4j0pmcobBKCRa62b',googleClientId:'',autoSync:true,connectedToggles:{steps:true,calories:true,heartRate:true,activity:true,sleep:true,training:true}};
const DEFAULT_DRIVE_SEEN=['1DB9fo_N1E8udcKQFRHemve8N4VVKes0M','1fmRWWyki0p7M6AvKVPPWrhGzzJlupaMW','1RIpyi5fj4VHpkT7Pp0YNjMdxJiLr2gvo','1p0kQQ-9vRdaAMzCNMGwOUIpktv7VCEA9','19FeCs5kWYSVwCqh31w3nUOxx_UduK9Kh'];
const TAGS=['restaurant','repas salé','voyage','mauvais sommeil','entraînement','écart alimentaire'];
const METRICS={weight:{label:'Poids',unit:'kg',digits:2},pbf:{label:'Graisse',unit:'%',digits:1},muscle:{label:'Muscle',unit:'kg',digits:1},fat:{label:'Masse grasse',unit:'kg',digits:2}};
let deferredPrompt=null;
let currentHomeDays=30,currentHomeMetric='weight',journalFilter='all';
let state=loadState();
let measurements=mergeMeasurements();

function loadState(){const baseConnected={...(window.BASE_CONNECTED||{})};try{const x=JSON.parse(localStorage.getItem(STORE)||'{}');return {settings:{...DEFAULT_SETTINGS,...(x.settings||{}),connectedToggles:{...DEFAULT_SETTINGS.connectedToggles,...(x.settings?.connectedToggles||{})}},extra:x.extra||[],context:x.context||{},connected:{...baseConnected,...(x.connected||{})},driveSeen:Array.isArray(x.driveSeen)?x.driveSeen:[...DEFAULT_DRIVE_SEEN],lastDriveSync:x.lastDriveSync||null};}catch(e){return {settings:{...DEFAULT_SETTINGS},extra:[],context:{},connected:baseConnected,driveSeen:[...DEFAULT_DRIVE_SEEN],lastDriveSync:null};}}
function saveState(){localStorage.setItem(STORE,JSON.stringify(state));}
function mergeMeasurements(){const all=[...(window.BASE_MEASUREMENTS||[]),...(state.extra||[])].map(m=>({...m})).sort((a,b)=>new Date(a.date)-new Date(b.date));const out=[];for(const m of all){const mt=+new Date(m.date);let dup=null;for(let i=out.length-1;i>=0;i--){const dt=Math.abs(mt-(+new Date(out[i].date)));if(dt>5*60*1000)break;if(Math.abs((out[i].weight??999)-(m.weight??-999))<=0.08){dup=out[i];break}}if(!dup){out.push(m);continue}for(const [k,v] of Object.entries(m)){if(v!==null&&v!==undefined&&v!=='')dup[k]=v}}return out;}
const $=s=>document.querySelector(s), $$=s=>[...document.querySelectorAll(s)];
const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));
const avg=a=>a.length?a.reduce((s,v)=>s+v,0)/a.length:null;
const sd=a=>{if(a.length<2)return 0;const m=avg(a);return Math.sqrt(a.reduce((s,v)=>s+(v-m)**2,0)/a.length)};
const fmt=(n,d=2)=>n==null||!isFinite(n)?'—':Number(n).toLocaleString('fr-FR',{minimumFractionDigits:d,maximumFractionDigits:d});
const isoDay=d=>new Date(d).toISOString().slice(0,10);
const frDate=(d,opts={day:'2-digit',month:'short',year:'numeric'})=>new Date(d).toLocaleDateString('fr-FR',opts);
const diffDays=(a,b)=>(new Date(a)-new Date(b))/DAY;
function toast(msg){const t=$('#toast');t.textContent=msg;t.classList.add('show');clearTimeout(toast._t);toast._t=setTimeout(()=>t.classList.remove('show'),2800)}
function latest(){return measurements[measurements.length-1]}
function contextFor(m){return state.context[m.date]||{tags:[],note:''}}
function nearestDaysBefore(m,days,tol=3){const target=new Date(m.date).getTime()-days*DAY;let best=null,bd=Infinity;for(const p of measurements){if(new Date(p.date)>=new Date(m.date))break;const dd=Math.abs(new Date(p.date).getTime()-target)/DAY;if(dd<bd&&dd<=tol){best=p;bd=dd}}return best}
function moving3(index=measurements.length-1,key='weight'){const a=measurements.slice(Math.max(0,index-2),index+1).map(m=>m[key]).filter(Number.isFinite);return avg(a)}
function metricChangeDays(key,days){const a=latest(),b=nearestDaysBefore(a,days,8);return b&&Number.isFinite(a[key])&&Number.isFinite(b[key])?a[key]-b[key]:null}
function target(){const s=state.settings;if(s.mode==='single')return {low:s.targetSingle-.5,high:s.targetSingle+.5,label:`${fmt(s.targetSingle,1)} kg`};return {low:Number(s.targetLow),high:Number(s.targetHigh),label:`${fmt(s.targetLow,0)} – ${fmt(s.targetHigh,0)} kg`}}
function inZone(w){const t=target();return w>=t.low&&w<=t.high}

function variationEvents(){const out=[];measurements.forEach((m,i)=>{if(i===0)return;const p=nearestDaysBefore(m,7,2);if(!p)return;const d=m.weight-p.weight;if(Math.abs(d)>=1)out.push({m,p,delta:d})});return out.sort((a,b)=>new Date(b.m.date)-new Date(a.m.date));}
function currentSignal(){const a=latest(),i=measurements.length-1,ma=moving3(i),prevMa=i>2?moving3(i-1):ma,week=nearestDaysBefore(a,7,3),d7=week?a.weight-week.weight:0;const gap=a.weight-ma;if(d7>0.6&&gap>0.25)return {title:'Hausse isolée',text:'Le poids actuel est nettement au-dessus de la moyenne mobile. Une mesure isolée ne suffit pas à conclure à une prise de graisse.',tone:'orange'};if(ma!=null&&prevMa!=null&&ma<prevMa-.12&&d7<-.2)return {title:'Baisse confirmée',text:'La moyenne mobile recule et le poids actuel reste sous la tendance récente.',tone:'green'};return {title:'Tendance stable',text:'La moyenne mobile varie peu. Les dernières mesures restent globalement cohérentes entre elles.',tone:'green'}}
function weeklyStats(){const a=latest(),end=new Date(a.date).getTime(),start=end-6.99*DAY,prevStart=end-13.99*DAY,prevEnd=end-7*DAY;const cur=measurements.filter(m=>{const t=+new Date(m.date);return t>=start&&t<=end});const prev=measurements.filter(m=>{const t=+new Date(m.date);return t>=prevStart&&t<prevEnd});const w=cur.map(x=>x.weight),pw=prev.map(x=>x.weight),t=target();return {cur,prev,avg:avg(w),prevAvg:avg(pw),delta:avg(w)!=null&&avg(pw)!=null?avg(w)-avg(pw):null,min:w.length?Math.min(...w):null,max:w.length?Math.max(...w):null,inZonePct:w.length?100*w.filter(x=>x>=t.low&&x<=t.high).length/w.length:null,pbf:avg(cur.map(x=>x.pbf).filter(Number.isFinite)),prevPbf:avg(prev.map(x=>x.pbf).filter(Number.isFinite)),muscle:avg(cur.map(x=>x.muscle).filter(Number.isFinite)),prevMuscle:avg(prev.map(x=>x.muscle).filter(Number.isFinite))}}

function sparkSVG(vals,color='#5b82ff'){if(!vals.length)return '';const W=70,H=28,min=Math.min(...vals),max=Math.max(...vals),pad=(max-min)||1;const pts=vals.map((v,i)=>`${4+i*(W-8)/Math.max(1,vals.length-1)},${H-4-(v-min)*(H-8)/pad}`).join(' ');return `<svg viewBox="0 0 ${W} ${H}" preserveAspectRatio="none"><polyline points="${pts}" fill="none" stroke="${color}" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>`}
function lineSVG(arr,key,{height=230,tags=false,weekly=false}={}){if(!arr.length)return '<div class="micro-note">Pas de données.</div>';const meta=METRICS[key]||METRICS.weight,W=420,H=height,L=34,R=12,T=20,B=30,vals=arr.map(x=>x[key]).filter(Number.isFinite);let min=Math.min(...vals),max=Math.max(...vals);let pad=(max-min)*.2||1;min-=pad;max+=pad;const x=i=>L+i*(W-L-R)/Math.max(1,arr.length-1),y=v=>T+(max-v)*(H-T-B)/(max-min);const pts=arr.map((p,i)=>[x(i),y(p[key])]);let s=`<svg viewBox="0 0 ${W} ${H}" preserveAspectRatio="none"><defs><linearGradient id="g${key}${height}" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#5c8bff" stop-opacity=".22"/><stop offset="1" stop-color="#5c8bff" stop-opacity=".02"/></linearGradient></defs>`;for(let i=0;i<4;i++){const gy=T+i*(H-T-B)/3,lab=max-i*(max-min)/3;s+=`<line x1="${L}" y1="${gy}" x2="${W-R}" y2="${gy}" stroke="#e3e9f2" stroke-width="1"/><text x="2" y="${gy+4}" fill="#7484a3" font-size="10">${fmt(lab,meta.digits)}</text>`}s+=`<path d="M ${pts[0][0]} ${H-B} L ${pts.map(p=>p.join(' ')).join(' L ')} L ${pts.at(-1)[0]} ${H-B} Z" fill="url(#g${key}${height})"/><polyline points="${pts.map(p=>p.join(',')).join(' ')}" fill="none" stroke="#4179f6" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>`;pts.forEach((p,i)=>{const c=contextFor(arr[i]);s+=`<circle cx="${p[0]}" cy="${p[1]}" r="${i===pts.length-1?4.6:3.2}" fill="${i===pts.length-1?'#3f7af7':'#fff'}" stroke="#3f7af7" stroke-width="2"/>`;if(tags&&c.tags?.length)s+=`<circle cx="${p[0]}" cy="${H-B+9}" r="3" fill="#7b4df6"/>`});const ticks=[0,Math.floor((arr.length-1)/2),arr.length-1];ticks.forEach((idx,j)=>s+=`<text x="${x(idx)}" y="${H-7}" text-anchor="${j===0?'start':j===2?'end':'middle'}" fill="#7484a3" font-size="10">${frDate(arr[idx].date,{day:'2-digit',month:'short'})}</text>`);const last=arr.at(-1);s+=`<g><rect x="${W-91}" y="${Math.max(4,y(last[key])-30)}" width="78" height="24" rx="9" fill="#fff" stroke="#e5ebf5"/><text x="${W-52}" y="${Math.max(20,y(last[key])-14)}" text-anchor="middle" fill="#172238" font-size="11" font-weight="700">${fmt(last[key],meta.digits)} ${meta.unit}</text></g></svg>`;return s}

function renderHome(){const a=latest(),b=nearestDaysBefore(a,7,3)||measurements.at(-2),t=target(),ma=moving3(),gap=a.weight-ma;$('#todayDate').textContent=frDate(a.date,{weekday:'long',day:'numeric',month:'long'});['#measureCount','#measureCount2','#measureCount3','#measureCount4'].forEach(id=>$(id).textContent=measurements.length);$('#currentWeight').textContent=fmt(a.weight);const d=a.weight-b.weight;$('#weekDelta').innerHTML=`${d<=0?'↓':'↑'} ${fmt(Math.abs(d))} kg <span>sur ${Math.round(Math.abs(diffDays(a.dat