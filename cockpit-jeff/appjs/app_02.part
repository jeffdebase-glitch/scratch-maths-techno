</div></div>`).join('');if(linked.length)html+=linked.map(x=>`<div class="corr-row"><div><strong>${x.label}</strong><small>Corrélation de Pearson sur ${x.n} jours appariés — corrélation ≠ causalité</small></div><div class="corr-value ${x.r>0?'pos':'neg'}">r = ${fmt(x.r,2)}</div></div>`).join('');$('#correlationPanel').innerHTML=html||'<div class="micro-note">Ajoutez des tags ou importez des données liées. Les associations apparaîtront lorsque l’échantillon sera suffisant.</div>'}
function matchedConnected(){return measurements.map(m=>({m,c:state.connected[isoDay(m.date)]})).filter(x=>x.c)}
function pearson(xs,ys){if(xs.length<3)return null;const mx=avg(xs),my=avg(ys);let a=0,b=0,c=0;for(let i=0;i<xs.length;i++){const dx=xs[i]-mx,dy=ys[i]-my;a+=dx*dy;b+=dx*dx;c+=dy*dy}return b&&c?a/Math.sqrt(b*c):null}
function linkedCorrelations(){const pairs=matchedConnected();if(pairs.length<5)return [];const fields=[['steps','Pas'],['sleepHours','Sommeil'],['trainingMinutes','Entraînement'],['calories','Calories'],['activityMinutes','Activité']];return fields.map(([k,label])=>{const p=pairs.filter(x=>Number.isFinite(Number(x.c[k])));return {label,n:p.length,r:pearson(p.map(x=>Number(x.c[k])),p.map(x=>x.m.weight))}}).filter(x=>x.n>=5&&x.r!=null)}

function renderSettings(){const s=state.settings;$('#driveFolderId').value=s.driveFolderId||'';$('#googleClientId').value=s.googleClientId||'';$('#autoSync').checked=!!s.autoSync;$('#targetLow').value=s.targetLow;$('#targetHigh').value=s.targetHigh;$('#targetSingle').value=s.targetSingle;$$('#modeSelect button').forEach(b=>b.classList.toggle('active',b.dataset.mode===s.mode));const labels={steps:'Pas',calories:'Calories',activity:'Activité',sleep:'Sommeil',training:'Entraînement'};$('#connectedToggles').innerHTML=Object.entries(labels).map(([k,l])=>`<div class="conn-row"><span>${l}</span><span class="switch ${s.connectedToggles[k]!==false?'on':''}" data-toggle="${k}"></span></div>`).join('');$$('[data-toggle]').forEach(el=>el.addEventListener('click',()=>{const k=el.dataset.toggle;s.connectedToggles[k]=!s.connectedToggles[k];saveState();renderSettings();renderHome()}));}

function switchView(id){$$('.view').forEach(v=>v.classList.toggle('active',v.id===id));$$('.nav-btn').forEach(b=>b.classList.toggle('active',b.dataset.nav===id));if(id==='today')renderHome();if(id==='trends')renderTrends();if(id==='data')renderData();if(id==='settings')renderSettings();window.scrollTo({top:0,behavior:'smooth'})}
function openModal(html){$('#modalContent').innerHTML=html;$('#modal').classList.remove('hidden')}
function closeModal(){$('#modal').classList.add('hidden')}
function openContext(date){const m=measurements.find(x=>x.date===date),c=contextFor(m),selected=new Set(c.tags||[]);openModal(`<h2>${frDate(m.date,{day:'numeric',month:'long'})} · ${fmt(m.weight)} kg</h2><p>Ajoutez le contexte qui peut aider à lire la variation, sans lui attribuer automatiquement une cause.</p><div class="tag-choices">${TAGS.map(t=>`<button class="tag-choice ${selected.has(t)?'selected':''}" data-tag="${t}">${t}</button>`).join('')}</div><textarea class="note-area" id="contextNote" placeholder="Note rapide…">${escapeHtml(c.note||'')}</textarea><button class="primary full" id="saveContext">Enregistrer</button>`);$$('.tag-choice').forEach(b=>b.addEventListener('click',()=>b.classList.toggle('selected')));$('#saveContext').addEventListener('click',()=>{state.context[date]={tags:$$('.tag-choice.selected').map(b=>b.dataset.tag),note:$('#contextNote').value.trim()};saveState();closeModal();renderData();renderHome();toast('Contexte enregistré')})}
function escapeHtml(s){return String(s).replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]))}


function monthlyStats(){const a=latest(),d=new Date(a.date),y=d.getFullYear(),m=d.getMonth(),pd=new Date(y,m-1,1),cur=measurements.filter(x=>{const z=new Date(x.date);return z.getFullYear()===y&&z.getMonth()===m}),prev=measurements.filter(x=>{const z=new Date(x.date);return z.getFullYear()===pd.getFullYear()&&z.getMonth()===pd.getMonth()}),w=cur.map(x=>x.weight),pw=prev.map(x=>x.weight),t=target();return {cur,prev,avg:avg(w),prevAvg:avg(pw),delta:avg(w)!=null&&avg(pw)!=null?avg(w)-avg(pw):null,min:w.length?Math.min(...w):null,max:w.length?Math.max(...w):null,inZonePct:w.length?100*w.filter(x=>x>=t.low&&x<=t.high).length/w.length:null,pbf:avg(cur.map(x=>x.pbf).filter(Number.isFinite)),prevPbf:avg(prev.map(x=>x.pbf).filter(Number.isFinite)),muscle:avg(cur.map(x=>x.muscle).filter(Number.isFinite)),prevMuscle:avg(prev.map(x=>x.muscle).filter(Number.isFinite)),label:frDate(a.date,{month:'long',year:'numeric'})}}

function weeklyReportHTML(){const w=weeklyStats(),t=target(),dp=w.delta,pc=w.pbf!=null&&w.prevPbf!=null?w.pbf-w.prevPbf:null,mc=w.muscle!=null&&w.prevMuscle!=null?w.muscle-w.prevMuscle:null;const verdict=w.inZonePct!=null&&w.inZonePct>=70?'Semaine stable':'Semaine à observer';return `<div id="weeklyReport"><div class="card-title-row"><div><div class="date-line">Rapport hebdomadaire</div><h2 style="margin:2px 0">${verdict}</h2><p>${w.cur.length} mesure${w.cur.length>1?'s':''} sur les 7 derniers jours.</p></div><div class="status-pill green">${fmt(w.inZonePct,0)} % dans la zone</div></div><div class="two-col"><div class="summary-box"><small>Moyenne semaine</small><strong>${fmt(w.avg)} kg</strong></div><div class="summary-box"><small>vs semaine précédente</small><strong style="color:${dp!=null&&dp<=0?'var(--green)':'var(--orange)'}">${dp==null?'—':(dp>=0?'+':'')+fmt(dp)+' kg'}</strong></div><div class="summary-box"><small>Amplitude</small><strong style="font-size:20px">${w.min==null?'—':fmt(w.min)+' – '+fmt(w.max)+' kg'}</strong></div><div class="summary-box"><small>Zone ${fmt(t.low,0)}–${fmt(t.high,0)}</small><strong>${fmt(w.inZonePct,0)} %</strong></div></div><div class="two-col" style="margin-top:12px"><div class="summary-box"><small>Graisse moyenne</small><strong>${fmt(w.pbf,1)} %</strong><small>${pc==null?'':(pc>=0?'+':'')+fmt(pc,1)+' pt vs semaine précédente'}</small></div><div class="summary-box"><small>Muscle moyen</small><strong>${fmt(w.muscle,1)} kg</strong><small>${mc==null?'':(mc>=0?'+':'')+fmt(mc,1)+' kg vs semaine précédente'}</small></div></div><div class="section-title" style="margin-top:16px">Évolution 7 jours</div><div class="svg-chart" style="height:180px">${lineSVG(w.cur.length?w.cur:measurements.slice(-5),'weight',{height:180,weekly:true})}</div><div class="help-box"><b>À retenir :</b> le bilan décrit la série disponible. Une semaine comportant peu de pesées est interprétée avec prudence.</div></div><div class="button-row"><button class="secondary" id="reportPng">Exporter en image</button><button class="primary" id="reportPdf">Exporter en PDF</button></div>`}
function openWeekly(){openModal(weeklyReportHTML());$('#reportPng').onclick=exportWeeklyPNG;$('#reportPdf').onclick=exportWeeklyPDF}

function reportCanvas(kind='week'){const w=kind==='month'?monthlyStats():weeklyStats(),canvas=document.createElement('canvas'),ctx=canvas.getContext('2d'),W=1200,H=1500;canvas.width=W;canvas.height=H;ctx.fillStyle='#f7faff';ctx.fillRect(0,0,W,H);const txt=(s,x,y,size=34,weight='400',color='#071228')=>{ctx.fillStyle=color;ctx.font=`${weight} ${size}px -apple-system,Arial,sans-serif`;ctx.fillText(s,x,y)};txt('Cockpit poids',80,100,54,'700');txt(kind==='month'?'Rapport mensuel':'Rapport hebdomadaire',80,158,32,'600','#637495');const box=(x,y,wid,hei,fill='#fff')=>{ctx.fillStyle=fill;roundRect(ctx,x,y,wid,hei,28);ctx.fill();ctx.strokeStyle='#e6ecf5';ctx.stroke()};box(70,210,1060,210);txt('Moyenne semaine',105,270,26,'500','#6d7d9b');txt(fmt(w.avg)+' kg',105,345,58,'700');txt('vs semaine precedente',650,270,26,'500','#6d7d9b');txt(w.delta==null?'—':(w.delta>=0?'+':'')+fmt(w.delta)+' kg',650,345,58,'700',w.delta!=null&&w.delta<=0?'#14985a':'#e47732');box(70,450,510,180,'#fff');box(620,450,510,180,'#fff');txt('Amplitude',105,505,24,'500','#6d7d9b');txt(w.min==null?'—':fmt(w.min)+' - '+fmt(w.max)+' kg',105,575,40,'700');txt('Dans la zone cible',655,505,24,'500','#6d7d9b');txt(fmt(w.inZonePct,0)+' %',655,575,46,'700','#14985a');box(70,660,1060,530,'#fff');txt('Evolution 7 jours',105,720,28,'600');const arr=w.cur.length?w.cur:measurements.slice(-5),vals=arr.map(x=>x.weight),min=Math.min(...vals)-.5,max=Math.max(...vals)+.5,L=120,R=1080,T=790,B=1110;ctx.strokeStyle='#e1e8f3';for(let i=0;i<4;i++){const y=T+i*(B-T)/3;ctx.beginPath();ctx.moveTo(L,y);ctx.lineTo(R,y);ctx.stroke()}ctx.strokeStyle='#4179f6';ctx.lineWidth=7;ctx.beginPath();arr.forEach((p,i)=>{const x=L+i*(R-L)/Math.max(1,arr.length-1),y=T+(max-p.weight)*(B-T)/(max-min);i?ctx.lineTo(x,y):ctx.moveTo(x,y)});ctx.stroke();txt('Zone cible : '+fmt(target().low,0)+' - '+fmt(target().high,0)+' kg',105,1260,26,'500','#6d7d9b');txt('Les variations sont des observations, pas des diagnostics.',105,1320,25,'400','#6d7d9b');txt(frDate(latest().date,{day:'numeric',month:'long',year:'numeric'}),105,1390,22,'400','#8794aa');return c