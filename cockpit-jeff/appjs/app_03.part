anvas}
function roundRect(ctx,x,y,w,h,r){const rr=Math.min(r,w/2,h/2);ctx.beginPath();ctx.moveTo(x+rr,y);ctx.arcTo(x+w,y,x+w,y+h,rr);ctx.arcTo(x+w,y+h,x,y+h,rr);ctx.arcTo(x,y+h,x,y,rr);ctx.arcTo(x,y,x+w,y,rr);ctx.closePath()}
function downloadBlob(blob,name){const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=name;document.body.appendChild(a);a.click();setTimeout(()=>{URL.revokeObjectURL(a.href);a.remove()},1000)}
function exportWeeklyPNG(){reportCanvas('week').toBlob(b=>downloadBlob(b,'cockpit-jeff-bilan-hebdo.png'),'image/png',1);toast('Image générée')}
function exportMonthlyPNG(){reportCanvas('month').toBlob(b=>downloadBlob(b,'cockpit-jeff-bilan-mensuel.png'),'image/png',1);toast('Image mensuelle générée')}
function ascii(s){return String(s).normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[–—]/g,'-').replace(/[’]/g,"'").replace(/[^\x20-\x7E]/g,'')}
function pdfEsc(s){return ascii(s).replace(/([\\()])/g,'\\$1')}
function makeSimplePDF(kind='week'){const w=kind==='month'?monthlyStats():weeklyStats(),lines=[[kind==='month'?'Cockpit poids - Rapport mensuel':'Cockpit poids - Rapport hebdomadaire',24],['Date: '+ascii(frDate(latest().date,{day:'numeric',month:'long',year:'numeric'})),12],['Moyenne semaine: '+fmt(w.avg)+' kg',16],['Vs semaine precedente: '+(w.delta==null?'—':(w.delta>=0?'+':'')+fmt(w.delta)+' kg'),16],['Amplitude: '+(w.min==null?'—':fmt(w.min)+' - '+fmt(w.max)+' kg'),16],['Mesures dans la zone: '+fmt(w.inZonePct,0)+' %',16],['Graisse moyenne: '+fmt(w.pbf,1)+' %',16],['Muscle moyen: '+fmt(w.muscle,1)+' kg',16],['Note: statistiques descriptives, sans interpretation diagnostique.',11]];let content='BT\n';let y=790;for(const [s,size] of lines){content+=`/F1 ${size} Tf 50 ${y} Td (${pdfEsc(s)}) Tj\n`;y-=size+24;content+=`0 0 Td\n`}content+='ET\n';const arr=w.cur.length?w.cur:measurements.slice(-5),vals=arr.map(x=>x.weight),min=Math.min(...vals)-.5,max=Math.max(...vals)+.5,L=55,R=540,T=350,B=520;content+='0.25 0.47 0.96 RG 2 w\n';arr.forEach((p,i)=>{const x=L+i*(R-L)/Math.max(1,arr.length-1),yy=T+(p.weight-min)*(B-T)/(max-min);content+=(i===0?`${x.toFixed(1)} ${yy.toFixed(1)} m\n`:`${x.toFixed(1)} ${yy.toFixed(1)} l\n`)});content+='S\n';const objs=[];objs[1]='<< /Type /Catalog /Pages 2 0 R >>';objs[2]='<< /Type /Pages /Kids [3 0 R] /Count 1 >>';objs[3]='<< /Type /Page /Parent 2 0 R /MediaBox [0 0 595 842] /Resources << /Font << /F1 4 0 R >> >> /Contents 5 0 R >>';objs[4]='<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>';objs[5]=`<< /Length ${content.length} >>\nstream\n${content}endstream`;let pdf='%PDF-1.4\n',offsets=[0];for(let i=1;i<=5;i++){offsets[i]=pdf.length;pdf+=`${i} 0 obj\n${objs[i]}\nendobj\n`}const xref=pdf.length;pdf+='xref\n0 6\n0000000000 65535 f \n';for(let i=1;i<=5;i++)pdf+=String(offsets[i]).padStart(10,'0')+' 00000 n \n';pdf+=`trailer\n<< /Size 6 /Root 1 0 R >>\nstartxref\n${xref}\n%%EOF`;return new Blob([new TextEncoder().encode(pdf)],{type:'application/pdf'})}
function exportWeeklyPDF(){downloadBlob(makeSimplePDF('week'),'cockpit-jeff-bilan-hebdo.pdf');toast('PDF généré')}
function exportMonthlyPDF(){downloadBlob(makeSimplePDF('month'),'cockpit-jeff-bilan-mensuel.pdf');toast('PDF mensuel généré')}

async function loadScript(src){if([...document.scripts].some(s=>s.src===src))return;await new Promise((res,rej)=>{const s=document.createElement('script');s.src=src;s.onload=res;s.onerror=rej;document.head.appendChild(s)})}
async function ensureOCR(){if(!window.pdfjsLib){await loadScript('https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js');pdfjsLib.GlobalWorkerOptions.workerSrc='https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js'}if(!window.Tesseract)await loadScript('https://cdn.jsdelivr.net/npm/tesseract.js@5/dist/tesseract.min.js')}
function dateFromFilename(name){const m=name.match(/(20\d{2})(\d{2})(\d{2})(\d{2})(\d{2})(\d{2})/);return m?`${m[1]}-${m[2]}-${m[3]}T${m[4]}:${m[5]}:00`:new Date().toISOString().slice(0,16)}
function dateFromOCRText(text,name){let m=text.match(/(\d{1,2})[\/.\-](\d{1,2})[\/.\-](20\d{2})\s+(\d{1,2})[:hH](\d{2})/);if(m)return `${m[3]}-${String(m[2]).padStart(2,'0')}-${String(m[1]).padStart(2,'0')}T${String(m[4]).padStart(2,'0')}:${m[5]}:00`;m=text.match(/(20\d{2})[\/.\-](\d{1,2})[\/.\-](\d{1,2})\s+(\d{1,2})[:hH](\d{2})/);if(m)return `${m[1]}-${String(m[2]).padStart(2,'0')}-${String(m[3]).padStart(2,'0')}T${String(m[4]).padStart(2,'0')}:${m[5]}:00`;return dateFromFilename(name)}
function num(x){return x==null?null:Number(String(x).replace(',','.'))}
function grab(text,label,unit){const e=label.replace(/[.*+?^${}()|[\]\\]/g,'\\$&').replace(/\s+/g,'\\s+');const r=new RegExp(e+'\\s*[:\\-]?\\s*(\\d{1,3}(?:[.,]\\d{1,2})?)\\s*'+(unit||''),'i');const m=text.match(r);return m?num(m[1]):null}
function parseOCRText(text,name){const weight=grab(text,'Weight','kg')??grab(text,'Body Weight','kg');const pbf=grab(text,'Body fat','%')??grab(text,'Body Fat','%')??grab(text,'PBF','%');const fat=grab(text,'Fat Mass','kg');const muscle=grab(text,'Skeletal Muscle','kg')??grab(text,'Muscle Mass','kg');const water=grab(text,'Water','kg')??grab(text,'Body water','kg')??grab(text,'Body Water','L');const bmr=grab(text,'BMR','kcal');return {date:dateFromOCRText(text,name),weight,pbf,fat:fat??(weight!=null&&pbf!=null?weight*pbf/100:null),muscle,water,lean:weight!=null&&fat!=null?weight-fat:null,bmr,source:'FitProfile OCR'}}
async function parseFitProfilePdf(blob,name){await ensureOCR();toast('OCR du PDF en cours…');const buf=await blob.arrayBuffer(),pdf=await pdfjsLib.getDocument({data:buf}).promise,page=await pdf.getPage(1),vp=page.getViewport({scale:2.2}),canvas=document.createElement('canvas'),ctx=canvas.getContext('2d');canvas.width=vp.width;canvas.height=vp.height;await page.render({canvasContext:ctx,viewport:vp}).promise;const out=await Tesseract.recognize(canvas,'eng');return {...parseOCRText(out.data.text,name),ocrText:out.data.text}}
function addMeasurement(m,driveId){if(!Number.isFinite(m.weight))return false;const clean={date:m.date,weight:+m.weight,pbf:Number.isFinite(m.pbf)?+m.pbf:null,fat:Number.isFinite(m.fat)?+m.fat:null,muscle:Number.isFinite(m.muscle)?+m.muscle:null,water:Number.isFinite(m.water)?+m.water:null,lean:Number.isFinite(m.lean)?+m.lean:(Number.isFinite(m.fat)?m.weight-m.fat:null),bmr:Number.isFinite(m.bmr)?+m.bmr:null,source:m.source||'FitProfile OCR',driveId:driveId||null};const idx=state.extra.findIndex(x=>x.date===clean.date);if(idx>=0)state.extra[idx]=clean;else state.extra.push(clean);if(driveId&&!state.driveSeen.includes(driveId))state.driveSeen.push(driveId);saveState();measurements=mergeMeasurements();return true}
function manualConfirm(parsed,name,driveId){openModal(`<h2>Vérifier la pesée</h2><p>L’OCR a lu le PDF « ${escapeHtml(name)} ». Vérifie les valeurs avant enregistrement.</p><div class="form-grid"><label>Date<input id="impDate" value="${parsed.date.slice(0,16)}" type="datetime-local"></label><label>Poids (kg)<input id="impWeight" value="${parsed.weight??''}" type="number" step="0.01"></label><label>Graisse (%)<input id="impPbf" value="${parsed.pbf??''}" type="number" step="0.1"></label><label>Masse grasse (kg)<input id="impFat" value="${parsed.fat??''}" type="number" step="0.01"></label><label>Muscle (kg)<input id="impMuscle" value="${parsed.muscle??''}" type="number" step="0.1"></label><label>BMR<input id="impBmr" value="${parsed.bmr??''}" type="number"></label></div><button class="primary full" id="saveImport">Ajouter la pesée</button>`);$('#saveImport').onclick=()=>{const m={date:$('#impDate').value,weight:num($('#impWeight').value),pbf:num($('#impPbf').value),fat:num($('#impFat').value),muscle:num($('#impMuscle').value),bmr:num($('#impBmr').value),source:'FitProfile OCR'};if(!m.weight)return toast('Poids requis');addMeasurement(m,driveId);closeModal();renderAll();toast('Pesée ajoutée')};}
async function importPDFs(files){for(const f of files){try{const p=await parseFitProfilePdf(f,f.name);manualConfirm(p,f.name,null);break}catch(e){console.error(e);toast('OCR impossible : '+e.message)}}}

async function backendDriveList(){const r=await fetch(`/.netlify/functions/drive-list?folderId=${encodeURIComponent(state.settings.driveFolderId)}`,{cache:'no-store'});if(!r.ok)throw new Error('backend absent');return (await r.json()).files||[]}
async function backendDriveFile(id){const r=await fetch(`/.netlify/functions/drive-file?id=${encodeURIComponent(id)}`);if(!r.ok)throw new Error('fichier Drive inaccessible');return await r.blob()}
async function browserToken(){if(!state.settings.googleClientId)throw new Error('Client ID Google manquant');await loadScript('https://accounts.google.com/gsi/client');return await new Promise((resolve,reject)=>{const c=google.accounts.oauth2.initTokenClient({client_id:state.settings.googleClientId,scope:'https://www.googleapis.com/auth/drive.readonly',callback:r=>r.error?reject(new Error(r.error)):resolve(r.access_token)});c.requestAccessToken({prompt:''})})}
